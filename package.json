{
  "name": "vscode-cspell-dict-extensions",
  "private": true,
  "version": "8.2.0",
  "scripts": {
    "test": "lerna run test",
    "postinstall": "lerna exec \"npm i\"",
    "pub-version": "lerna version --conventional-commits",
    "publish-all": "lerna exec --no-bail \"vsce publish\"",
    "publish-all-ovsx": "lerna exec --no-bail \"ovsx publish --pat \\$OVSX_TOKEN\"",
    "gen:readme": "node ./scripts/update-code-workspace.mts",
    "gen:release-please": "node ./scripts/gen-release-please-config.mts",
    "gen:workflow": "node ./scripts/update-workflows.mts",
    "echo": "echo $OVSX_TOKEN",
    "build": "lerna run build",
    "check-types": "lerna run check-types",
    "test-pack": "lerna run pack-extension",
    "cspell": "npx cspell . --dot  --no-progress",
    "create:extension": "node ./extension-tools/create.mts",
    "lint:code": "oxlint --type-aware --deny-warnings",
    "prettier:fix": "prettier --write .",
    "prettier:lint": "prettier --check .",
    "test:all": "lerna run --concurrency=1 --stream \"--scope=code-spell-checker-*\" test",
    "test:cspell": "lerna run --concurrency=4 --stream \"--scope=code-spell-checker-*\" test:cspell",
    "test:download-vscode": "download-vscode ",
    "sync:extensions": "node ./extension-tools/cli.mts sync",
    "check:extensions": "node ./extension-tools/cli.mts check",
    "extension-tools": "node ./extension-tools/cli.mts",
    "tool:gen-extension-list": "node ./scripts/gen-extension-list.mts",
    "lint": "npm run cspell",
    "update-dictionaries": "lerna exec \"npx npm-check-updates -t latest -u -f \\\"@cspell*\\\" \" && npm i && npm run sync:extensions",
    "update-packages": "npm ci && npx npm-check-updates -t semver -u && npm i && lerna exec \"npx npm-check-updates -t semver -u && rm -rf node_modules package-lock.json && npm i\" && npm i && npm run sync:extensions",
    "list:packages": "node ./extension-tools/cli.mts packages",
    "fetch:sample": "node ./extension-tools/cli.mts fetch-sample",
    "check:extension": "node ./scripts/check-extension.mts"
  },
  "type": "commonjs",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@lerna-lite/cli": "^5.6.4",
    "@lerna-lite/exec": "^5.6.4",
    "@lerna-lite/run": "^5.6.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "cspell": "^10.4.0",
    "inject-markdown": "^6.2.1",
    "npm-check-updates": "^23.1.1",
    "ovsx": "^1.3.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "scripts": "file:scripts",
    "test-extensions": "file:test-runner",
    "ts-json-schema-generator": "^2.9.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
