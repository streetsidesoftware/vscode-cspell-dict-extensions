exports[`writeExtension > renders the templates: natural language dictionary 1`] = `
{
  "package.json": "{\\n  \\"name\\": \\"code-spell-checker-swedish\\",\\n  \\"description\\": \\"Swedish dictionary extension for VS Code.\\",\\n  \\"version\\": \\"0.1.0\\",\\n  \\"displayName\\": \\"Swedish - Code Spell Checker\\",\\n  \\"icon\\": \\"images/SpellCheck.png\\",\\n  \\"private\\": true,\\n  \\"publisher\\": \\"streetsidesoftware\\",\\n  \\"author\\": \\"Street Side Software <support@streetsidesoftware.nl>\\",\\n  \\"contributors\\": [],\\n  \\"license\\": \\"GPL-3.0-or-later\\",\\n  \\"type\\": \\"commonjs\\",\\n  \\"engines\\": {\\n    \\"vscode\\": \\"^1.125.0\\"\\n  },\\n  \\"sponsor\\": {\\n    \\"url\\": \\"https://github.com/sponsors/streetsidesoftware\\"\\n  },\\n  \\"extensionKind\\": [\\n    \\"workspace\\"\\n  ],\\n  \\"categories\\": [\\n    \\"Linters\\",\\n    \\"Other\\"\\n  ],\\n  \\"keywords\\": [\\n    \\"Swedish\\",\\n    \\"VS Code Extension\\",\\n    \\"Spelling Checker\\",\\n    \\"dictionary\\",\\n    \\"spelling\\"\\n  ],\\n  \\"activationEvents\\": [\\n    \\"onStartupFinished\\"\\n  ],\\n  \\"qna\\": \\"marketplace\\",\\n  \\"main\\": \\"./out/extension.js\\",\\n  \\"capabilities\\": {\\n    \\"virtualWorkspaces\\": true,\\n    \\"untrustedWorkspaces\\": {\\n      \\"supported\\": true\\n    }\\n  },\\n  \\"contributes\\": {\\n    \\"commands\\": [\\n      {\\n        \\"command\\": \\"cSpellExt_swedish.enable\\",\\n        \\"title\\": \\"Enable Swedish Spell Checker Dictionary\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_swedish.disable\\",\\n        \\"title\\": \\"Disable Swedish Spell Checker Dictionary\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_swedish.enableWorkspace\\",\\n        \\"title\\": \\"Enable Swedish Spell Checker Dictionary in Workspace\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_swedish.disableWorkspace\\",\\n        \\"title\\": \\"Disable Swedish Spell Checker Dictionary in Workspace\\"\\n      }\\n    ]\\n  },\\n  \\"extensionDependencies\\": [\\n    \\"streetsidesoftware.code-spell-checker\\"\\n  ],\\n  \\"repository\\": {\\n    \\"type\\": \\"git\\",\\n    \\"url\\": \\"https://github.com/streetsidesoftware/vscode-cspell-dict-extensions\\"\\n  },\\n  \\"bugs\\": {\\n    \\"url\\": \\"https://github.com/streetsidesoftware/vscode-cspell-dict-extensions/issues\\"\\n  },\\n  \\"scripts\\": {\\n    \\"clean\\": \\"rimraf out\\",\\n    \\"clean-build\\": \\"npm run clean && npm run build\\",\\n    \\"publish-extension\\": \\"vsce publish\\",\\n    \\"pack-extension\\": \\"vsce package\\",\\n    \\"vscode:prepublish\\": \\"npm run build\\",\\n    \\"build\\": \\"tsc -p ./\\",\\n    \\"watch\\": \\"tsc -watch -p ./\\",\\n    \\"test:cspell\\": \\"cspell -c cspell-ext.json samples\\",\\n    \\"test:vscode\\": \\"node ../../test-runner/bin.mjs . --sample samples/seattle.md\\",\\n    \\"test\\": \\"npm run test:cspell && npm run test:vscode\\"\\n  }\\n}\\n",
  "README.md": "# Swedish - Code Spell Checker\\n\\nSwedish dictionary extension for VS Code.\\n\\nImports the Swedish spell checking dictionary for [Code Spell Checker](https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker).\\n\\n## Installation\\n\\nAfter this extension is installed, it is necessary to tell the spell checker to use it.\\n\\n### Enable Dictionary\\n\\nCommands (use \`F1\` or *View -> Command Palette...*):\\n- \`Enable Swedish Spell Checker Dictionary\`\\n- \`Enable Swedish Spell Checker Dictionary in Workspace\`\\n\\nOr:\\n- \`F1\` \`Show Spell Checker Configuration Info\`\\n- Select the \`Language\` tab.\\n- Enable the language Globally or in just the Workspace.\\n\\n### Disable Dictionary\\n\\nCommands (use \`F1\` or *View -> Command Palette...*):\\n- \`Disable Swedish Spell Checker Dictionary\`\\n- \`Disable Swedish Spell Checker Dictionary in Workspace\`\\n\\n### Manual Settings\\n\\nThis is done with the \`language\` setting.\\n\\n*Preferences* -> *Settings*\\n\\nAdding \`sv_SE\` to the \`cSpell.language\` setting, will enable the Swedish dictionary.\\nExample using both English and Swedish dictionaries:\\n\`\`\`javascript\\n\\"cSpell.language\\": \\"en,sv_SE\\",\\n\`\`\`\\n\\n## Requirements\\nThis extension will automatically include [Code Spell Checker](https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker) extension.\\n\\n<!--- @@inject: ../../static/footer.md --->\\n",
  "CHANGELOG.md": "# Change Log\\nAll notable changes to the \\"code-spell-checker-swedish\\" extension will be documented in this file.\\n\\n## [Unreleased]\\n- Initial release\\n\\n## References\\nCheck [Keep a Changelog](http://keepachangelog.com/) for recommendations on how to structure this file.\\n\\n",
  "cspell-ext.json": "{\\n    \\"import\\": [\\"@cspell/dict-sv/cspell-ext.json\\"]\\n}\\n",
  "src/extension.ts": "import * as vscode from 'vscode';\\n\\n/** The part of the Code Spell Checker extension API that this extension uses. */\\ninterface CodeSpellCheckerExtension {\\n    registerConfig(path: string): Promise<void>;\\n    enableLocale(isGlobal: boolean, locale: string): Promise<void>;\\n    disableLocale(isGlobal: boolean, locale: string): Promise<void>;\\n}\\n\\nconst locale = 'sv_SE';\\n\\n/**\\n * Called by VS Code when the extension is loaded.\\n */\\nexport async function activate(context: vscode.ExtensionContext) {\\n    const vscodeSpellCheckerExtension = 'streetsidesoftware.code-spell-checker';\\n    const configLocation = context.asAbsolutePath('./cspell-ext.json');\\n\\n    const extension = vscode.extensions.getExtension<CodeSpellCheckerExtension>(vscodeSpellCheckerExtension);\\n\\n    async function enable(isGlobal: boolean) {\\n        const ext = await extension?.activate();\\n        await ext?.enableLocale(isGlobal, locale);\\n    }\\n\\n    async function disable(isGlobal: boolean) {\\n        const ext = await extension?.activate();\\n        await ext?.disableLocale(isGlobal, locale);\\n    }\\n\\n    context.subscriptions.push(\\n        vscode.commands.registerCommand('cSpellExt_swedish.enable', () => enable(true)),\\n        vscode.commands.registerCommand('cSpellExt_swedish.disable', () => disable(true)),\\n        vscode.commands.registerCommand('cSpellExt_swedish.enableWorkspace', () => enable(false)),\\n        vscode.commands.registerCommand('cSpellExt_swedish.disableWorkspace', () => disable(false)),\\n    );\\n\\n    // Register this extension's configuration with Code Spell Checker.\\n    const ext = await extension?.activate();\\n    await ext?.registerConfig(configLocation);\\n}\\n\\n/**\\n * Called by VS Code when the extension is unloaded.\\n */\\nexport function deactivate() {}\\n",
  "samples/cspell.json": "{\\n    \\"language\\": \\"sv_SE\\",\\n    \\"dictionaries\\": []\\n}\\n",
  "samples/seattle.md": "[Seattle - Wikipedia](https://en.wikipedia.org/wiki/Seattle)\\n\\nhttps://sv.wikipedia.org/wiki/Seattle\\n\\n<!---\\nPlease download some sample text. The Seattle wikipedia site is translated into many languages and provides a good sample.\\n--->\\n"
}
`;

exports[`writeExtension > renders the templates: parser 1`] = `
{
  "package.json": "{\\n  \\"name\\": \\"code-spell-checker-typescript-parser\\",\\n  \\"description\\": \\"TypeScript Parser parser extension for VS Code.\\",\\n  \\"version\\": \\"0.1.0\\",\\n  \\"displayName\\": \\"TypeScript Parser - Code Spell Checker\\",\\n  \\"icon\\": \\"images/SpellCheck.png\\",\\n  \\"private\\": true,\\n  \\"publisher\\": \\"streetsidesoftware\\",\\n  \\"author\\": \\"Street Side Software <support@streetsidesoftware.nl>\\",\\n  \\"contributors\\": [],\\n  \\"license\\": \\"GPL-3.0-or-later\\",\\n  \\"type\\": \\"commonjs\\",\\n  \\"engines\\": {\\n    \\"vscode\\": \\"^1.125.0\\"\\n  },\\n  \\"sponsor\\": {\\n    \\"url\\": \\"https://github.com/sponsors/streetsidesoftware\\"\\n  },\\n  \\"extensionKind\\": [\\n    \\"workspace\\"\\n  ],\\n  \\"categories\\": [\\n    \\"Linters\\",\\n    \\"Other\\"\\n  ],\\n  \\"keywords\\": [\\n    \\"TypeScript Parser\\",\\n    \\"VS Code Extension\\",\\n    \\"Spelling Checker\\",\\n    \\"dictionary\\",\\n    \\"spelling\\"\\n  ],\\n  \\"activationEvents\\": [\\n    \\"onStartupFinished\\"\\n  ],\\n  \\"qna\\": \\"marketplace\\",\\n  \\"main\\": \\"./out/extension.js\\",\\n  \\"capabilities\\": {\\n    \\"virtualWorkspaces\\": true,\\n    \\"untrustedWorkspaces\\": {\\n      \\"supported\\": true\\n    }\\n  },\\n  \\"contributes\\": {\\n    \\"commands\\": [\\n    ]\\n  },\\n  \\"extensionDependencies\\": [\\n    \\"streetsidesoftware.code-spell-checker\\"\\n  ],\\n  \\"repository\\": {\\n    \\"type\\": \\"git\\",\\n    \\"url\\": \\"https://github.com/streetsidesoftware/vscode-cspell-dict-extensions\\"\\n  },\\n  \\"bugs\\": {\\n    \\"url\\": \\"https://github.com/streetsidesoftware/vscode-cspell-dict-extensions/issues\\"\\n  },\\n  \\"scripts\\": {\\n    \\"clean\\": \\"rimraf out\\",\\n    \\"clean-build\\": \\"npm run clean && npm run build\\",\\n    \\"publish-extension\\": \\"vsce publish\\",\\n    \\"pack-extension\\": \\"vsce package\\",\\n    \\"vscode:prepublish\\": \\"npm run build\\",\\n    \\"build\\": \\"tsc -p ./\\",\\n    \\"watch\\": \\"tsc -watch -p ./\\",\\n    \\"test:cspell\\": \\"cspell -c cspell-ext.json samples\\",\\n    \\"test:vscode\\": \\"node ../../test-runner/bin.mjs . --sample samples/seattle.md\\",\\n    \\"test\\": \\"npm run test:cspell && npm run test:vscode\\"\\n  }\\n}\\n",
  "README.md": "# TypeScript Parser - Code Spell Checker\\n\\nTypeScript Parser parser extension for VS Code.\\n\\nAdds the TypeScript Parser parser to [Code Spell Checker](https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker).\\n\\n## Enable / Disable\\n\\nThe parser is on while this extension is enabled. To turn it off, use **Disable** or **Disable (Workspace)** on this extension in the Extensions view.\\n\\n## Requirements\\nThis extension will automatically include [Code Spell Checker](https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker) extension.\\n\\n<!--- @@inject: ../../static/footer.md --->\\n",
  "CHANGELOG.md": "# Change Log\\nAll notable changes to the \\"code-spell-checker-typescript-parser\\" extension will be documented in this file.\\n\\n## [Unreleased]\\n- Initial release\\n\\n## References\\nCheck [Keep a Changelog](http://keepachangelog.com/) for recommendations on how to structure this file.\\n\\n",
  "cspell-ext.json": "{\\n    \\"import\\": [\\"@cspell/parser-typescript/recommended\\"]\\n}\\n",
  "src/extension.ts": "import * as vscode from 'vscode';\\n\\n/** The part of the Code Spell Checker extension API that this extension uses. */\\ninterface CodeSpellCheckerExtension {\\n    registerConfig(path: string): Promise<void>;\\n}\\n\\n\\n/**\\n * Called by VS Code when the extension is loaded.\\n */\\nexport async function activate(context: vscode.ExtensionContext) {\\n    const vscodeSpellCheckerExtension = 'streetsidesoftware.code-spell-checker';\\n    const configLocation = context.asAbsolutePath('./cspell-ext.json');\\n\\n    const extension = vscode.extensions.getExtension<CodeSpellCheckerExtension>(vscodeSpellCheckerExtension);\\n\\n    // Register this extension's configuration with Code Spell Checker.\\n    const ext = await extension?.activate();\\n    await ext?.registerConfig(configLocation);\\n}\\n\\n/**\\n * Called by VS Code when the extension is unloaded.\\n */\\nexport function deactivate() {}\\n",
  "samples/cspell.json": "{\\n    \\"dictionaries\\": []\\n}\\n",
  "samples/seattle.md": "[Seattle - Wikipedia](https://en.wikipedia.org/wiki/Seattle)\\n\\nhttps://en.wikipedia.org/wiki/Seattle\\n\\n<!---\\nPlease download some sample text. The Seattle wikipedia site is translated into many languages and provides a good sample.\\n--->\\n"
}
`;

exports[`writeExtension > renders the templates: scaffold with a locale 1`] = `
{
  "package.json": "{\\n  \\"name\\": \\"code-spell-checker-extra\\",\\n  \\"description\\": \\"Extra dictionary extension for VS Code.\\",\\n  \\"version\\": \\"0.1.0\\",\\n  \\"displayName\\": \\"Extra - Code Spell Checker\\",\\n  \\"icon\\": \\"images/SpellCheck.png\\",\\n  \\"private\\": true,\\n  \\"publisher\\": \\"streetsidesoftware\\",\\n  \\"author\\": \\"Street Side Software <support@streetsidesoftware.nl>\\",\\n  \\"contributors\\": [],\\n  \\"license\\": \\"GPL-3.0-or-later\\",\\n  \\"type\\": \\"commonjs\\",\\n  \\"engines\\": {\\n    \\"vscode\\": \\"^1.125.0\\"\\n  },\\n  \\"sponsor\\": {\\n    \\"url\\": \\"https://github.com/sponsors/streetsidesoftware\\"\\n  },\\n  \\"extensionKind\\": [\\n    \\"workspace\\"\\n  ],\\n  \\"categories\\": [\\n    \\"Linters\\",\\n    \\"Other\\"\\n  ],\\n  \\"keywords\\": [\\n    \\"Extra\\",\\n    \\"VS Code Extension\\",\\n    \\"Spelling Checker\\",\\n    \\"dictionary\\",\\n    \\"spelling\\"\\n  ],\\n  \\"activationEvents\\": [\\n    \\"onStartupFinished\\"\\n  ],\\n  \\"qna\\": \\"marketplace\\",\\n  \\"main\\": \\"./out/extension.js\\",\\n  \\"capabilities\\": {\\n    \\"virtualWorkspaces\\": true,\\n    \\"untrustedWorkspaces\\": {\\n      \\"supported\\": true\\n    }\\n  },\\n  \\"contributes\\": {\\n    \\"commands\\": [\\n      {\\n        \\"command\\": \\"cSpellExt_extra.enable\\",\\n        \\"title\\": \\"Enable Extra Spell Checker Dictionary\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_extra.disable\\",\\n        \\"title\\": \\"Disable Extra Spell Checker Dictionary\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_extra.enableWorkspace\\",\\n        \\"title\\": \\"Enable Extra Spell Checker Dictionary in Workspace\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_extra.disableWorkspace\\",\\n        \\"title\\": \\"Disable Extra Spell Checker Dictionary in Workspace\\"\\n      }\\n    ]\\n  },\\n  \\"extensionDependencies\\": [\\n    \\"streetsidesoftware.code-spell-checker\\"\\n  ],\\n  \\"repository\\": {\\n    \\"type\\": \\"git\\",\\n    \\"url\\": \\"https://github.com/streetsidesoftware/vscode-cspell-dict-extensions\\"\\n  },\\n  \\"bugs\\": {\\n    \\"url\\": \\"https://github.com/streetsidesoftware/vscode-cspell-dict-extensions/issues\\"\\n  },\\n  \\"scripts\\": {\\n    \\"clean\\": \\"rimraf out\\",\\n    \\"clean-build\\": \\"npm run clean && npm run build\\",\\n    \\"publish-extension\\": \\"vsce publish\\",\\n    \\"pack-extension\\": \\"vsce package\\",\\n    \\"vscode:prepublish\\": \\"npm run build\\",\\n    \\"build\\": \\"tsc -p ./\\",\\n    \\"watch\\": \\"tsc -watch -p ./\\",\\n    \\"test:cspell\\": \\"cspell -c cspell-ext.json samples\\",\\n    \\"test:vscode\\": \\"node ../../test-runner/bin.mjs . --sample samples/seattle.md\\",\\n    \\"test\\": \\"npm run test:cspell && npm run test:vscode\\"\\n  }\\n}\\n",
  "README.md": "# Extra - Code Spell Checker\\n\\nExtra dictionary extension for VS Code.\\n\\nExtends [Code Spell Checker](https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker).\\n\\n## Installation\\n\\nAfter this extension is installed, it is necessary to tell the spell checker to use it.\\n\\n### Enable Dictionary\\n\\nCommands (use \`F1\` or *View -> Command Palette...*):\\n- \`Enable Extra Spell Checker Dictionary\`\\n- \`Enable Extra Spell Checker Dictionary in Workspace\`\\n\\nOr:\\n- \`F1\` \`Show Spell Checker Configuration Info\`\\n- Select the \`Language\` tab.\\n- Enable the language Globally or in just the Workspace.\\n\\n### Disable Dictionary\\n\\nCommands (use \`F1\` or *View -> Command Palette...*):\\n- \`Disable Extra Spell Checker Dictionary\`\\n- \`Disable Extra Spell Checker Dictionary in Workspace\`\\n\\n### Manual Settings\\n\\nThis is done with the \`language\` setting.\\n\\n*Preferences* -> *Settings*\\n\\nAdding \`&lt;locale&gt;\` to the \`cSpell.language\` setting, will enable the Extra dictionary.\\nExample using both English and Extra dictionaries:\\n\`\`\`javascript\\n\\"cSpell.language\\": \\"en,&lt;locale&gt;\\",\\n\`\`\`\\n\\n## Requirements\\nThis extension will automatically include [Code Spell Checker](https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker) extension.\\n\\n<!--- @@inject: ../../static/footer.md --->\\n",
  "CHANGELOG.md": "# Change Log\\nAll notable changes to the \\"code-spell-checker-extra\\" extension will be documented in this file.\\n\\n## [Unreleased]\\n- Initial release\\n\\n## References\\nCheck [Keep a Changelog](http://keepachangelog.com/) for recommendations on how to structure this file.\\n\\n",
  "cspell-ext.json": "{\\n    \\"import\\": []\\n}\\n",
  "src/extension.ts": "import * as vscode from 'vscode';\\n\\n/** The part of the Code Spell Checker extension API that this extension uses. */\\ninterface CodeSpellCheckerExtension {\\n    registerConfig(path: string): Promise<void>;\\n    enableLocale(isGlobal: boolean, locale: string): Promise<void>;\\n    disableLocale(isGlobal: boolean, locale: string): Promise<void>;\\n}\\n\\n// TODO: fill in what the enable / disable commands toggle.\\nconst locale = '';\\n\\n/**\\n * Called by VS Code when the extension is loaded.\\n */\\nexport async function activate(context: vscode.ExtensionContext) {\\n    const vscodeSpellCheckerExtension = 'streetsidesoftware.code-spell-checker';\\n    const configLocation = context.asAbsolutePath('./cspell-ext.json');\\n\\n    const extension = vscode.extensions.getExtension<CodeSpellCheckerExtension>(vscodeSpellCheckerExtension);\\n\\n    async function enable(isGlobal: boolean) {\\n        const ext = await extension?.activate();\\n        await ext?.enableLocale(isGlobal, locale);\\n    }\\n\\n    async function disable(isGlobal: boolean) {\\n        const ext = await extension?.activate();\\n        await ext?.disableLocale(isGlobal, locale);\\n    }\\n\\n    context.subscriptions.push(\\n        vscode.commands.registerCommand('cSpellExt_extra.enable', () => enable(true)),\\n        vscode.commands.registerCommand('cSpellExt_extra.disable', () => disable(true)),\\n        vscode.commands.registerCommand('cSpellExt_extra.enableWorkspace', () => enable(false)),\\n        vscode.commands.registerCommand('cSpellExt_extra.disableWorkspace', () => disable(false)),\\n    );\\n\\n    // Register this extension's configuration with Code Spell Checker.\\n    const ext = await extension?.activate();\\n    await ext?.registerConfig(configLocation);\\n}\\n\\n/**\\n * Called by VS Code when the extension is unloaded.\\n */\\nexport function deactivate() {}\\n",
  "samples/cspell.json": "{\\n    \\"dictionaries\\": []\\n}\\n",
  "samples/seattle.md": "[Seattle - Wikipedia](https://en.wikipedia.org/wiki/Seattle)\\n\\nhttps://en.wikipedia.org/wiki/Seattle\\n\\n<!---\\nPlease download some sample text. The Seattle wikipedia site is translated into many languages and provides a good sample.\\n--->\\n"
}
`;

