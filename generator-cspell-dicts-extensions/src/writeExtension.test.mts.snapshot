  "package.json": "{\\n  \\"name\\": \\"code-spell-checker-extra\\",\\n  \\"description\\": \\"Extra dictionary extension for VS Code.\\",\\n  \\"version\\": \\"0.1.0\\",\\n  \\"displayName\\": \\"Extra - Code Spell Checker\\",\\n  \\"icon\\": \\"images/SpellCheck.png\\",\\n  \\"private\\": true,\\n  \\"publisher\\": \\"streetsidesoftware\\",\\n  \\"author\\": \\"Street Side Software <support@streetsidesoftware.nl>\\",\\n  \\"contributors\\": [],\\n  \\"license\\": \\"GPL-3.0-or-later\\",\\n  \\"type\\": \\"commonjs\\",\\n  \\"engines\\": {\\n    \\"vscode\\": \\"^1.125.0\\"\\n  },\\n  \\"sponsor\\": {\\n    \\"url\\": \\"https://github.com/sponsors/streetsidesoftware\\"\\n  },\\n  \\"extensionKind\\": [\\n    \\"workspace\\"\\n  ],\\n  \\"categories\\": [\\n    \\"Linters\\",\\n    \\"Other\\"\\n  ],\\n  \\"keywords\\": [\\n    \\"Extra\\",\\n    \\"VS Code Extension\\",\\n    \\"Spelling Checker\\",\\n    \\"dictionary\\",\\n    \\"spelling\\"\\n  ],\\n  \\"activationEvents\\": [\\n    \\"onStartupFinished\\"\\n  ],\\n  \\"qna\\": \\"marketplace\\",\\n  \\"main\\": \\"./out/extension.js\\",\\n  \\"capabilities\\": {\\n    \\"virtualWorkspaces\\": true,\\n    \\"untrustedWorkspaces\\": {\\n      \\"supported\\": true\\n    }\\n  },\\n  \\"contributes\\": {\\n    \\"commands\\": [\\n      {\\n        \\"command\\": \\"cSpellExt_extra.enable\\",\\n        \\"title\\": \\"Enable Extra Spell Checker Dictionary\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_extra.disable\\",\\n        \\"title\\": \\"Disable Extra Spell Checker Dictionary\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_extra.enableWorkspace\\",\\n        \\"title\\": \\"Enable Extra Spell Checker Dictionary in Workspace\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_extra.disableWorkspace\\",\\n        \\"title\\": \\"Disable Extra Spell Checker Dictionary in Workspace\\"\\n      }\\n    ]\\n  },\\n  \\"extensionDependencies\\": [\\n    \\"streetsidesoftware.c