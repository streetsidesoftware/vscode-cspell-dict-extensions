{
  "package.json": "{\\n  \\"name\\": \\"code-spell-checker-medical-terms\\",\\n  \\"description\\": \\"Medical Terms dictionary extension for VS Code.\\",\\n  \\"version\\": \\"0.1.0\\",\\n  \\"displayName\\": \\"Medical Terms - Code Spell Checker\\",\\n  \\"icon\\": \\"images/SpellCheck.png\\",\\n  \\"private\\": true,\\n  \\"publisher\\": \\"streetsidesoftware\\",\\n  \\"author\\": \\"Street Side Software <support@streetsidesoftware.nl>\\",\\n  \\"contributors\\": [],\\n  \\"license\\": \\"GPL-3.0-or-later\\",\\n  \\"type\\": \\"commonjs\\",\\n  \\"engines\\": {\\n    \\"vscode\\": \\"^1.125.0\\"\\n  },\\n  \\"sponsor\\": {\\n    \\"url\\": \\"https://github.com/sponsors/streetsidesoftware\\"\\n  },\\n  \\"extensionKind\\": [\\n    \\"workspace\\"\\n  ],\\n  \\"categories\\": [\\n    \\"Linters\\",\\n    \\"Other\\"\\n  ],\\n  \\"keywords\\": [\\n    \\"Medical Terms\\",\\n    \\"VS Code Extension\\",\\n    \\"Spelling Checker\\",\\n    \\"dictionary\\",\\n    \\"spelling\\"\\n  ],\\n  \\"activationEvents\\": [\\n    \\"onStartupFinished\\"\\n  ],\\n  \\"qna\\": \\"marketplace\\",\\n  \\"main\\": \\"./out/extension.js\\",\\n  \\"capabilities\\": {\\n    \\"virtualWorkspaces\\": true,\\n    \\"untrustedWorkspaces\\": {\\n      \\"supported\\": true\\n    }\\n  },\\n  \\"contributes\\": {\\n    \\"commands\\": [\\n      {\\n        \\"command\\": \\"cSpellExt_medical-terms.enable\\",\\n        \\"title\\": \\"Enable Medical Terms Spell Checker Dictionary\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_medical-terms.disable\\",\\n        \\"title\\": \\"Disable Medical Terms Spell Checker Dictionary\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_medical-terms.enableWorkspace\\",\\n        \\"title\\": \\"Enable Medical Terms Spell Checker Dictionary in Workspace\\"\\n      },\\n      {\\n        \\"command\\": \\"cSpellExt_medical-terms.disableWorkspace\\",\\n        \\"title\\": \\"Disable Medical Terms Spell Checker Dictionary in Workspace\\"\\n      }\\n    ]\\n  },\\n  \\"extensionDependencies\\": [\\n    \\"streetsidesoftware.code-spell-checker\\"\\n  ],\\n  \\"repository\\": {\\n    \\"type\\": \\"git\\",\\n    \\"url\\": \\"https://github.com/streetsidesoftware/vscode-cspell-dict-extensions\\"\\n  },\\n  \\"bugs\\": {\\n    \\"url\\": \\"https://github.com/streetsidesoftware/vscode-cspell-dict-extensions/issues\\"\\n  },\\n  \\"scripts\\": {\\n    \\"clean\\": \\"rimraf out\\",\\n    \\"clean-build\\": \\"npm run clean && npm run build\\",\\n    \\"publish-extension\\": \\"vsce publish\\",\\n    \\"pack-extension\\": \\"vsce package\\",\\n    \\"vscode:prepublish\\": \\"npm run build\\",\\n    \\"build\\": \\"tsc -p ./\\",\\n    \\"watch\\": \\"tsc -watch -p ./\\",\\n    \\"test:cspell\\": \\"cspell -c cspell-ext.json samples\\",\\n    \\"test:vscode\\": \\"node ../../test-runner/bin.mjs . --sample samples/seattle.md\\",\\n    \\"test\\": \\"npm run test:cspell && npm run test:vscode\\"\\n  }\\n}\\n",
  "README.md": "# Medical Terms - Code Spell Checker\\n\\nMedical Terms dictionary extension for VS Code.\\n\\nImports the Medical Terms spell checking dictionary for [Code Spell Checker](https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker).\\n\\n## Enable / Disable\\n\\nCommands (use \`F1\` or *View -> Command Palette...*):\\n- \`Enable Medical Terms Spell Checker Dictionary\`\\n- \`Disable Medical Terms Spell Checker Dictionary\`\\n- \`Enable Medical Terms Spell Checker Dictionary in Workspace\`\\n- \`Disable Medical Terms Spell Checker Dictionary in Workspace\`\\n\\n### Manual Settings\\n\\nThis is done with the \`dictionaries\` setting. A \`!\` before a name turns the dictionary off.\\n\\n\`\`\`javascript\\n\\"cSpell.dictionaries\\": [\\"medical terms\\"],\\n\`\`\`\\n\\n## Requirements\\nThis extension will automatically include [Code Spell Checker](https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker) extension.\\n\\n<!--- @@inject: ../../static/footer.md --->\\n",
  "CHANGELOG.md": "# Change Log\\nAll notable changes to the \\"code-spell-checker-medical-terms\\" extension will be documented in this file.\\n\\n## [Unreleased]\\n- Initial release\\n\\n## References\\nCheck [Keep a Changelog](http://keepachangelog.com/) for recommendations on how to structure this file.\\n\\n",
  "cspell-ext.json": "{\\n    \\"import\\": [\\"@cspell/dict-medicalterms/cspell-ext.json\\"]\\n}\\n",
  "src/extension.ts": "import * as vscode from 'vscode';\\n\\n/** The part of the Code Spell Checker extension API that this extension uses. */\\ninterface CodeSpellCheckerExtension {\\n    registerConfig(path: string): Promise<void>;\\n}\\n\\nconst dictionaries: string[] = [\\"medical terms\\"];\\n\\n/**\\n * Called by VS Code when the extension is loaded.\\n */\\nexport async function activate(context: vscode.ExtensionContext) {\\n    const vscodeSpellCheckerExtension = 'streetsidesoftware.code-spell-checker';\\n    const configLocation = context.asAbsolutePath('./cspell-ext.json');\\n\\n    const extension = vscode.extensions.getExtension<CodeSpellCheckerExtension>(vscodeSpellCheckerExtension);\\n\\n    // Code Spell Checker has no API to toggle a dictionary, so update the \`cSpell.dictionaries\` setting.\\n    // A \`!\` before a name turns the dictionary off.\\n    async function toggle(isGlobal: boolean, on: boolean) {\\n        const config = vscode.workspace.getConfiguration('cSpell');\\n        const values = config.inspect<string[]>('dictionaries');\\n        const current = (isGlobal ? values?.globalValue : values?.workspaceValue) ?? [];\\n        const names = new Set(dictionaries.flatMap((name) => [name, '!' + name]));\\n        const updated = [...current.filter((name) => !names.has(name)), ...dictionaries.map((name) => (on ? name : '!' + name))];\\n        const target = isGlobal ? vscode.ConfigurationTarget.Global : vscode.ConfigurationTarget.Workspace;\\n        await config.update('dictionaries', updated, target);\\n    }\\n\\n    const enable = (isGlobal: boolean) => toggle(isGlobal, true);\\n    const disable = (isGlobal: boolean) => toggle(isGlobal, false);\\n\\n    context.subscriptions.push(\\n        vscode.commands.registerCommand('cSpellExt_medical-terms.enable', () => enable(true)),\\n        vscode.commands.registerCommand('cSpellExt_medical-terms.disable', () => disable(true)),\\n        vscode.commands.registerCommand('cSpellExt_medical-terms.enableWorkspace', () => enable(false)),\\n        vscode.commands.registerCommand('cSpellExt_medical-terms.disableWorkspace', () => disable(false)),\\n    );\\n\\n    // Register this extension's configuration with Code Spell Checker.\\n    const ext = await extension?.activate();\\n    await ext?.registerConfig(configLocation);\\n}\\n\\n/**\\n * Called by VS Code when the extension is unloaded.\\n */\\nexport function deactivate() {}\\n",
  "samples/cspell.json": "{\\n    \\"dictionaries\\": [\\"medical terms\\"]\\n}\\n",
  "samples/seattle.md": "[Seattle - Wikipedia](https://en.wikipedia.org/wiki/Seattle)\\n\\nhttps://en.wikipedia.org/wiki/Seattle\\n\\n<!---\\nPlease download some sample text. The Seattle wikipedia site is translated into many languages and provides a good sample.\\n--->\\n"
}
