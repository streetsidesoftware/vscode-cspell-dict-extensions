{
  "name": "generator-cspell-dict-extensions",
  "version": "0.1.4",
  "description": "Generate VS Code cspell dictionary extension.",
  "homepage": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions",
  "author": {
    "name": "Street Side Software",
    "email": "jason@streetsidesoftware.nl"
  },
  "type": "module",
  "private": true,
  "files": [
    "run.mts",
    "src",
    "!src/**/*.test.mts",
    "templates"
  ],
  "bin": "./run.mts",
  "keywords": [
    "VS Code spelling dictionary extension generator"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "check-types": "tsc -p .",
    "test": "node --test \"src/**/*.test.mts\""
  },
  "repository": "git@github.com:streetsidesoftware/vscode-cspell-dict-extensions",
  "license": "MIT"
}
