{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "ignorePatterns": ["**/out/**", "**/samples/**", "**/.vscode-test/**", "**/static/**"],
    "rules": {
        "typescript/no-floating-promises": [
            "warn",
            {
                "allowForKnownSafeCalls": [
                    {
                        "from": "package",
                        "package": "node:test",
                        "name": ["describe", "suite", "test", "it"]
                    }
                ]
            }
        ]
    }
}
