{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "ignorePatterns": [
        "**/out/**",
        "extensions/*/extension.js",
        "**/samples/**",
        "**/.vscode-test/**",
        "**/static/**",
        "extension-tools/templates/**"
    ],
    "rules": {
        "typescript/no-floating-promises": [
            "warn",
            {
                "allowForKnownSafeCalls": [
                    {
                        "from": "package",
                        "package": "node:test",
                        "name": ["describe", "it"]
                    }
                ]
            }
        ]
    }
}
