{
    "$schema": "../../static/extension.config.schema.json",
    "name": "hebrew",
    "friendlyName": "Hebrew",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-he/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "he"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "he"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "he",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "he",
            "scope": "workspace"
        }
    ]
}
