{
    "$schema": "../../static/extension.config.schema.json",
    "name": "basque",
    "kind": "language",
    "friendlyName": "Basque",
    "nativeName": "euskara",
    "locale": "eu",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-eu/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "eu"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "eu"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "eu",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "eu",
            "scope": "workspace"
        }
    ]
}
