{
    "$schema": "../../static/extension.config.schema.json",
    "name": "canadian-english",
    "kind": "language",
    "friendlyName": "Canadian English",
    "locale": "en-ca",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-en-ca/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "en-ca"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "en-ca"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "en-ca",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "en-ca",
            "scope": "workspace"
        }
    ]
}
