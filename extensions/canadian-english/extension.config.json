{
    "$schema": "../../extension-runtime/extension.config.schema.json",
    "name": "canadian-english",
    "kind": "language",
    "friendlyName": "Canadian English",
    "displayName": "Canadian English - Code Spell Checker",
    "description": "Adds Canadian English spell checking to Code Spell Checker.",
    "locale": "en-CA",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-en-ca/cspell-ext.json"]
    },
    "commands": [
        {
            "id": "cSpellExt_canadian-english.enable",
            "title": "Enable Canadian English Spell Checker Dictionary",
            "action": "enable",
            "toggle": "locale",
            "value": "en-ca",
            "scope": "global"
        },
        {
            "id": "cSpellExt_canadian-english.disable",
            "title": "Disable Canadian English Spell Checker Dictionary",
            "action": "disable",
            "toggle": "locale",
            "value": "en-ca",
            "scope": "global"
        },
        {
            "id": "cSpellExt_canadian-english.enableWorkspace",
            "title": "Enable Canadian English Spell Checker Dictionary in Workspace",
            "action": "enable",
            "toggle": "locale",
            "value": "en-ca",
            "scope": "workspace"
        },
        {
            "id": "cSpellExt_canadian-english.disableWorkspace",
            "title": "Disable Canadian English Spell Checker Dictionary in Workspace",
            "action": "disable",
            "toggle": "locale",
            "value": "en-ca",
            "scope": "workspace"
        }
    ]
}
