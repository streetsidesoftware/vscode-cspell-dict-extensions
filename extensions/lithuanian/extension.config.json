{
    "$schema": "../../static/extension.config.schema.json",
    "name": "lithuanian",
    "kind": "language",
    "friendlyName": "Lithuanian",
    "nativeName": "lietuvių",
    "locale": "lt",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-lt-lt/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "lt"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "lt"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "lt",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "lt",
            "scope": "workspace"
        }
    ]
}
