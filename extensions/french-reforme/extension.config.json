{
    "$schema": "../../static/extension.config.schema.json",
    "name": "french-reforme",
    "kind": "language",
    "friendlyName": "French Réforme 90",
    "locale": "fr-90",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-fr-reforme/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "id": "cSpellExt_french-reforme.enableFrench",
            "title": "Enable French Reforme Spell Checker Dictionary"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "id": "cSpellExt_french-reforme.disableFrench",
            "title": "Disable French Reforme Spell Checker Dictionary"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpellExt_french-reforme.enableFrenchWorkspace",
            "title": "Enable French Reforme Spell Checker Dictionary in Workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpellExt_french-reforme.disableFrenchWorkspace",
            "title": "Disable French Reforme Spell Checker Dictionary in Workspace"
        }
    ]
}
