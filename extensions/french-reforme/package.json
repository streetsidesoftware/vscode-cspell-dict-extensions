{
  "name": "code-spell-checker-french-reforme",
  "displayName": "French Réforme 90 - Code Spell Checker",
  "version": "3.0.0",
  "private": true,
  "description": "Adds French Réforme 90 (français) spell checking to Code Spell Checker.",
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "French Réforme 90",
    "VS Code Extension",
    "Spelling Checker",
    "dictionary",
    "spelling"
  ],
  "bugs": {
    "url": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions",
    "directory": "extensions/french-reforme"
  },
  "license": "MIT",
  "qna": "marketplace",
  "author": "Street Side Software <support@streetsidesoftware.nl>",
  "contributors": [],
  "publisher": "streetsidesoftware",
  "type": "module",
  "main": "./out/extension.js",
  "scripts": {
    "build": "tsdown",
    "clean": "node ../../scripts/clean.mts",
    "clean-build": "npm run clean && npm run build",
    "pack-extension": "vsce package",
    "publish-extension": "vsce publish",
    "test": "npm run test:cspell && npm run test:vscode",
    "test:cspell": "cspell -c static/cspell-ext.json samples",
    "test:vscode": "node ../../test-runner/bin.mjs . --sample samples/seattle.md",
    "vscode:prepublish": "npm run build",
    "watch": "tsdown --watch"
  },
  "contributes": {
    "commands": [
      {
        "command": "cSpellExt_french-reforme.enable",
        "title": "Enable French Réforme 90 Spell Checker Dictionary"
      },
      {
        "command": "cSpellExt_french-reforme.disable",
        "title": "Disable French Réforme 90 Spell Checker Dictionary"
      },
      {
        "command": "cSpellExt_french-reforme.enableWorkspace",
        "title": "Enable French Réforme 90 Spell Checker Dictionary in Workspace"
      },
      {
        "command": "cSpellExt_french-reforme.disableWorkspace",
        "title": "Disable French Réforme 90 Spell Checker Dictionary in Workspace"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "@cspell/dict-fr-reforme": "^2.3.2"
  },
  "extensionDependencies": [
    "streetsidesoftware.code-spell-checker"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "images/SpellCheck.png",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "sponsor": {
    "url": "https://github.com/sponsors/streetsidesoftware"
  },
  "vsce": {
    "baseContentUrl": "https://raw.githubusercontent.com/streetsidesoftware/vscode-cspell-dict-extensions/refs/heads/main/extensions/french-reforme/",
    "baseImagesUrl": "https://raw.githubusercontent.com/streetsidesoftware/vscode-cspell-dict-extensions/refs/heads/main/extensions/french-reforme/"
  }
}
