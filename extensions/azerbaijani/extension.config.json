{
    "$schema": "../../static/extension.config.schema.json",
    "name": "azerbaijani",
    "kind": "language",
    "friendlyName": "Azerbaijani",
    "nativeName": "azərbaycan",
    "locale": "az-az",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-az-az/cspell-ext.json"],
        "engines": {
            "cspell": ">=10.4.0",
            "code-spell-checker": ">=4.10.0"
        }
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale"
        },
        {
            "action": "disable",
            "toggle": "locale"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace"
        }
    ]
}
