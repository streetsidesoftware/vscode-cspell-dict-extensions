{
  "name": "code-spell-checker-scientific-terms",
  "displayName": "Scientific Terms - Code Spell Checker",
  "version": "1.0.0",
  "private": true,
  "description": "Adds the Scientific Terms dictionary to Code Spell Checker.",
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "Scientific Terms",
    "VS Code Extension",
    "Spelling Checker",
    "dictionary",
    "spelling"
  ],
  "bugs": {
    "url": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions",
    "directory": "extensions/scientific-terms"
  },
  "license": "GPL-3.0-or-later",
  "qna": "marketplace",
  "author": "Street Side Software <support@streetsidesoftware.nl>",
  "contributors": [],
  "publisher": "streetsidesoftware",
  "type": "module",
  "main": "./out/extension.js",
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf out",
    "clean-build": "npm run clean && npm run build",
    "pack-extension": "vsce package",
    "publish-extension": "vsce publish",
    "test": "npm run test:cspell && npm run test:vscode",
    "test:cspell": "cspell -c static/cspell-ext.json samples",
    "test:vscode": "node ../../test-runner/bin.mjs . --sample samples/README.md",
    "vscode:prepublish": "npm run build",
    "watch": "tsdown --watch"
  },
  "contributes": {
    "commands": []
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "@cspell/dict-scientific-terms-us": "^3.1.1"
  },
  "extensionDependencies": [
    "streetsidesoftware.code-spell-checker"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "images/SpellCheck.png",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "sponsor": {
    "url": "https://github.com/sponsors/streetsidesoftware"
  },
  "vsce": {
    "baseContentUrl": "https://raw.githubusercontent.com/streetsidesoftware/vscode-cspell-dict-extensions/refs/heads/main/extensions/scientific-terms/",
    "baseImagesUrl": "https://raw.githubusercontent.com/streetsidesoftware/vscode-cspell-dict-extensions/refs/heads/main/extensions/scientific-terms/"
  }
}
