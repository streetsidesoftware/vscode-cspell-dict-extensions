{
    "$schema": "../../static/extension.config.schema.json",
    "name": "indonesian",
    "kind": "language",
    "friendlyName": "Indonesian",
    "nativeName": "Indonesia",
    "locale": "id-id",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-id-id/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale"
        },
        {
            "action": "disable",
            "toggle": "locale"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace"
        }
    ]
}
