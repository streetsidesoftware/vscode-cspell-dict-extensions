{
    "$schema": "../../static/extension.config.schema.json",
    "name": "portuguese",
    "kind": "language",
    "friendlyName": "Portuguese",
    "nativeName": "português",
    "locale": "pt-PT",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-pt-pt/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "pt"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "pt"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "pt",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "pt",
            "scope": "workspace"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "pt",
            "id": "cSpellExt_portuguese.enablePortuguese",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "pt",
            "id": "cSpellExt_portuguese.disablePortuguese",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "pt",
            "scope": "workspace",
            "id": "cSpellExt_portuguese.enablePortugueseWorkspace",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "pt",
            "scope": "workspace",
            "id": "cSpellExt_portuguese.disablePortugueseWorkspace",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        }
    ]
}
