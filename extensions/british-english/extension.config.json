{
    "$schema": "../../static/extension.config.schema.json",
    "name": "british-english",
    "kind": "language",
    "friendlyName": "British English",
    "locale": "en-GB",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-en-gb/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "title": "Enable British Spell Checker Dictionary"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "title": "Disable British Spell Checker Dictionary"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace",
            "title": "Enable British Spell Checker Dictionary in Workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace",
            "title": "Disable British Spell Checker Dictionary in Workspace"
        }
    ]
}
