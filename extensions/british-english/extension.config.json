{
    "$schema": "../../extension-runtime/extension.config.schema.json",
    "name": "british-english",
    "kind": "language",
    "friendlyName": "British English",
    "displayName": "British English - Code Spell Checker",
    "description": "Adds British English spell checking to Code Spell Checker.",
    "locale": "en-GB",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-en-gb/cspell-ext.json"]
    },
    "commands": [
        {
            "id": "cSpellExt_british-english.enable",
            "title": "Enable British English Spell Checker Dictionary",
            "action": "enable",
            "toggle": "locale",
            "value": "en-GB",
            "scope": "global"
        },
        {
            "id": "cSpellExt_british-english.disable",
            "title": "Disable British English Spell Checker Dictionary",
            "action": "disable",
            "toggle": "locale",
            "value": "en-GB",
            "scope": "global"
        },
        {
            "id": "cSpellExt_british-english.enableWorkspace",
            "title": "Enable British English Spell Checker Dictionary in Workspace",
            "action": "enable",
            "toggle": "locale",
            "value": "en-GB",
            "scope": "workspace"
        },
        {
            "id": "cSpellExt_british-english.disableWorkspace",
            "title": "Disable British English Spell Checker Dictionary in Workspace",
            "action": "disable",
            "toggle": "locale",
            "value": "en-GB",
            "scope": "workspace"
        }
    ]
}
