{
    "$schema": "../../static/extension.config.schema.json",
    "name": "armenian",
    "kind": "language",
    "friendlyName": "Armenian",
    "nativeName": "հայերեն",
    "locale": "hy",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-hy/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale"
        },
        {
            "action": "disable",
            "toggle": "locale"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace"
        }
    ]
}
