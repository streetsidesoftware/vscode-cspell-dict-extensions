{
    "$schema": "../../static/extension.config.schema.json",
    "name": "catalan",
    "kind": "language",
    "friendlyName": "Catalan",
    "nativeName": "català",
    "locale": "ca",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-ca/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "id": "cSpellExt_catalan.enableCatalan"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "id": "cSpellExt_catalan.disableCatalan"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpellExt_catalan.enableCatalanWorkspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpellExt_catalan.disableCatalanWorkspace"
        }
    ]
}
