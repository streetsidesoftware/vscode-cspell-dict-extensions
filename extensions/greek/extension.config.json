{
    "$schema": "../../extension-runtime/extension.config.schema.json",
    "name": "greek",
    "kind": "language",
    "friendlyName": "Greek",
    "displayName": "Greek - Code Spell Checker",
    "description": "Adds Greek (Ελληνικά) spell checking to Code Spell Checker.",
    "nativeName": "Ελληνικά",
    "locale": "el",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-el/cspell-ext.json"]
    },
    "commands": [
        {
            "id": "cSpellExt_greek.enable",
            "title": "Enable Greek Spell Checker Dictionary",
            "action": "enable",
            "toggle": "locale",
            "value": "el",
            "scope": "global"
        },
        {
            "id": "cSpellExt_greek.disable",
            "title": "Disable Greek Spell Checker Dictionary",
            "action": "disable",
            "toggle": "locale",
            "value": "el",
            "scope": "global"
        },
        {
            "id": "cSpellExt_greek.enableWorkspace",
            "title": "Enable Greek Spell Checker Dictionary in Workspace",
            "action": "enable",
            "toggle": "locale",
            "value": "el",
            "scope": "workspace"
        },
        {
            "id": "cSpellExt_greek.disableWorkspace",
            "title": "Disable Greek Spell Checker Dictionary in Workspace",
            "action": "disable",
            "toggle": "locale",
            "value": "el",
            "scope": "workspace"
        }
    ]
}
