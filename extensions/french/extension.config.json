{
    "$schema": "../../extension-runtime/extension.config.schema.json",
    "name": "french",
    "kind": "language",
    "friendlyName": "French",
    "displayName": "French - Code Spell Checker",
    "description": "Adds French (français) spell checking to Code Spell Checker.",
    "nativeName": "français",
    "locale": "fr-FR",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-fr-fr/cspell-ext.json"]
    },
    "commands": [
        {
            "id": "cSpellExt_french.enable",
            "title": "Enable French Spell Checker Dictionary",
            "action": "enable",
            "toggle": "locale",
            "value": "fr-FR",
            "scope": "global"
        },
        {
            "id": "cSpellExt_french.disable",
            "title": "Disable French Spell Checker Dictionary",
            "action": "disable",
            "toggle": "locale",
            "value": "fr-FR",
            "scope": "global"
        },
        {
            "id": "cSpellExt_french.enableWorkspace",
            "title": "Enable French Spell Checker Dictionary in Workspace",
            "action": "enable",
            "toggle": "locale",
            "value": "fr-FR",
            "scope": "workspace"
        },
        {
            "id": "cSpellExt_french.disableWorkspace",
            "title": "Disable French Spell Checker Dictionary in Workspace",
            "action": "disable",
            "toggle": "locale",
            "value": "fr-FR",
            "scope": "workspace"
        }
    ],
    "notes": "Enable uses `fr-FR`. French Réforme 90 declares `fr,fr-fr,fr-90`, so `fr-FR` also turns it on when it is installed; no locale is exclusive to classic French. Disable removes only `fr-FR`, not `fr`: `fr` is shared with other French variants and French Réforme 90, so a user who added `fr` keeps this dictionary on."
}
