{
    "$schema": "../../static/extension.config.schema.json",
    "name": "french",
    "kind": "language",
    "friendlyName": "French",
    "nativeName": "français",
    "locale": "fr",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-fr-fr/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "fr"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "fr,fr-FR"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "fr",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "fr,fr-FR",
            "scope": "workspace"
        }
    ],
    "notes": "Enable uses `fr`, not `fr-FR`: this dictionary declares `fr,fr_FR`, and French Réforme 90 declares `fr,fr-fr,fr-90`, so `fr-FR` would turn on both. No locale is exclusive to classic French."
}
