{
    "$schema": "../../static/extension.config.schema.json",
    "name": "russian",
    "kind": "language",
    "friendlyName": "Russian",
    "nativeName": "русский",
    "locale": "ru",
    "sample": "samples/portland.md",
    "cspell": {
        "version": "0.2",
        "readonly": true,
        "import": ["@cspell/dict-ru_ru/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "id": "cSpellExt_russian.enableRussian"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "id": "cSpellExt_russian.disableRussian"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpellExt_russian.enableRussianWorkspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpellExt_russian.disableRussianWorkspace"
        }
    ]
}
