{
    "$schema": "../../static/extension.config.schema.json",
    "name": "austrian-german",
    "kind": "language",
    "friendlyName": "Austrian German",
    "nativeName": "Österreichisches Deutsch",
    "locale": "de-AT",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-de-at/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "de-at"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "de-at"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "de-at",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "de-at",
            "scope": "workspace"
        }
    ]
}
