{
    "$schema": "../../static/extension.config.schema.json",
    "name": "romanian",
    "kind": "language",
    "friendlyName": "Romanian",
    "nativeName": "română",
    "locale": "ro-ro",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-ro-ro/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale"
        },
        {
            "action": "disable",
            "toggle": "locale"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace"
        }
    ]
}
