{
    "$schema": "../../extension-runtime/extension.config.schema.json",
    "name": "dutch",
    "kind": "language",
    "friendlyName": "Dutch",
    "displayName": "Dutch - Code Spell Checker",
    "description": "Adds Dutch (Nederlands) spell checking to Code Spell Checker.",
    "nativeName": "Nederlands",
    "locale": "nl-NL",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-nl-nl/cspell-ext.json"]
    },
    "commands": [
        {
            "id": "cSpellExt_dutch.enable",
            "title": "Enable Dutch Spell Checker Dictionary",
            "action": "enable",
            "toggle": "locale",
            "value": "nl-NL",
            "scope": "global"
        },
        {
            "id": "cSpellExt_dutch.disable",
            "title": "Disable Dutch Spell Checker Dictionary",
            "action": "disable",
            "toggle": "locale",
            "value": "nl-NL,nl",
            "scope": "global"
        },
        {
            "id": "cSpellExt_dutch.enableWorkspace",
            "title": "Enable Dutch Spell Checker Dictionary in Workspace",
            "action": "enable",
            "toggle": "locale",
            "value": "nl-NL",
            "scope": "workspace"
        },
        {
            "id": "cSpellExt_dutch.disableWorkspace",
            "title": "Disable Dutch Spell Checker Dictionary in Workspace",
            "action": "disable",
            "toggle": "locale",
            "value": "nl-NL,nl",
            "scope": "workspace"
        }
    ]
}
