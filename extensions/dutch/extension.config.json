{
    "$schema": "../../static/extension.config.schema.json",
    "name": "dutch",
    "kind": "language",
    "friendlyName": "Dutch",
    "nativeName": "Nederlands",
    "locale": "nl-NL",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-nl-nl/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "nl-NL"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "nl-NL"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "nl-NL",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "nl-NL",
            "scope": "workspace"
        }
    ],
    "notes": "Disable removes only `nl-NL`, not `nl`: `nl` is shared with Flemish (nl-BE), so a user who added `nl` keeps this dictionary on."
}
