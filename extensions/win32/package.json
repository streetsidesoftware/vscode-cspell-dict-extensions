{
  "name": "code-spell-checker-win32",
  "displayName": "Win32 - Code Spell Checker",
  "version": "2.1.0",
  "private": true,
  "description": "Adds the Win32 dictionary to Code Spell Checker.",
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "Win32",
    "VS Code Extension",
    "Spelling Checker",
    "dictionary",
    "spelling"
  ],
  "bugs": {
    "url": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions",
    "directory": "extensions/win32"
  },
  "license": "GPL-3.0-or-later",
  "qna": "marketplace",
  "author": "Street Side Software <support@streetsidesoftware.nl>",
  "contributors": [],
  "publisher": "streetsidesoftware",
  "type": "module",
  "main": "./extension.js",
  "scripts": {
    "build": "tsdown",
    "clean": "node ../../scripts/clean.mts",
    "clean-build": "npm run clean && npm run build",
    "pack-extension": "vsce package --allow-unused-files-pattern",
    "publish-extension": "vsce publish",
    "test": "npm run test:cspell && npm run test:vscode",
    "test:cspell": "cspell -c static/cspell-ext.json samples",
    "test:vscode": "node ../../test-runner/bin.mjs . --sample samples/window_sample.cpp",
    "vscode:prepublish": "npm run build",
    "watch": "tsdown --watch"
  },
  "contributes": {
    "commands": [
      {
        "command": "cSpellExt_win32.enable",
        "title": "Enable Win32 Spell Checker Dictionary"
      },
      {
        "command": "cSpellExt_win32.disable",
        "title": "Disable Win32 Spell Checker Dictionary"
      },
      {
        "command": "cSpellExt_win32.enableWorkspace",
        "title": "Enable Win32 Spell Checker Dictionary in Workspace"
      },
      {
        "command": "cSpellExt_win32.disableWorkspace",
        "title": "Disable Win32 Spell Checker Dictionary in Workspace"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "@cspell/dict-win32": "^2.0.10"
  },
  "extensionDependencies": [
    "streetsidesoftware.code-spell-checker"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "images/SpellCheck.png",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "sponsor": {
    "url": "https://github.com/sponsors/streetsidesoftware"
  },
  "vsce": {
    "baseContentUrl": "https://raw.githubusercontent.com/streetsidesoftware/vscode-cspell-dict-extensions/refs/heads/main/extensions/win32/",
    "baseImagesUrl": "https://raw.githubusercontent.com/streetsidesoftware/vscode-cspell-dict-extensions/refs/heads/main/extensions/win32/"
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "extension.js",
    "images/SpellCheck.png",
    "static/cspell-ext.json",
    "node_modules/**"
  ]
}
