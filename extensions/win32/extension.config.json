{
    "$schema": "../../static/extension.config.schema.json",
    "name": "win32",
    "kind": "wordList",
    "friendlyName": "Win32",
    "sample": "samples/window_sample.cpp",
    "cspell": {
        "import": ["@cspell/dict-win32/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "dictionary",
            "value": "win32"
        },
        {
            "action": "disable",
            "toggle": "dictionary",
            "value": "win32"
        },
        {
            "action": "enable",
            "toggle": "dictionary",
            "value": "win32",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "dictionary",
            "value": "win32",
            "scope": "workspace"
        }
    ]
}
