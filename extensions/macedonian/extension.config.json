{
    "$schema": "../../static/extension.config.schema.json",
    "name": "macedonian",
    "kind": "language",
    "friendlyName": "Macedonian",
    "nativeName": "македонски",
    "locale": "mk",
    "sample": "samples/Skopje.md",
    "cspell": {
        "import": ["@cspell/dict-mk/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "mk"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "mk"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "mk",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "mk",
            "scope": "workspace"
        }
    ]
}
