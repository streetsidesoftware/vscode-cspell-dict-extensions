{
    "$schema": "../../static/extension.config.schema.json",
    "name": "norwegian-bokmal",
    "kind": "language",
    "friendlyName": "Norwegian Bokmål",
    "nativeName": "norsk bokmål",
    "locale": "nb",
    "sample": "samples/norge.md",
    "cspell": {
        "import": ["@cspell/dict-nb-no/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale"
        },
        {
            "action": "disable",
            "toggle": "locale"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace"
        }
    ]
}
