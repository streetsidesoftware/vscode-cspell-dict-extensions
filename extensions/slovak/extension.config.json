            "action": "enable",
            "toggle": "locale",
            "value": "sk"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "sk"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "sk",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "sk",
            "scope": "workspace"
        },
        {
            "action": "enable",
            "toggle": "locale",
