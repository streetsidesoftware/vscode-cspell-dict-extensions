{
  "name": "code-spell-checker-medical-terms",
  "displayName": "Medical Terms - Code Spell Checker",
  "version": "4.1.1",
  "private": true,
  "description": "Adds the Medical Terms dictionary to Code Spell Checker.",
  "categories": [
    "Linters",
    "Other"
  ],
  "bugs": {
    "url": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions",
    "directory": "extensions/medical-terms"
  },
  "license": "GPL-3.0-or-later",
  "qna": "marketplace",
  "author": "Street Side Software <support@streetsidesoftware.nl>",
  "contributors": [],
  "publisher": "streetsidesoftware",
  "type": "module",
  "main": "./out/extension.js",
  "scripts": {
    "build": "tsdown",
    "clean": "node ../../scripts/clean.mts",
    "clean-build": "npm run clean && npm run build",
    "pack-extension": "vsce package",
    "publish-extension": "vsce publish",
    "test": "npm run test:cspell && npm run test:vscode",
    "test:cspell": "cspell -c static/cspell-ext.json samples",
    "test:vscode": "node ../../test-runner/bin.mjs . --sample samples/README.md",
    "vscode:prepublish": "npm run build",
    "watch": "tsdown --watch"
  },
  "contributes": {
    "commands": [
      {
        "command": "cSpellExt_medical-terms.enable",
        "title": "Enable Medical Terms Spell Checker Dictionary"
      },
      {
        "command": "cSpellExt_medical-terms.disable",
        "title": "Disable Medical Terms Spell Checker Dictionary"
      },
      {
        "command": "cSpellExt_medical-terms.enableWorkspace",
        "title": "Enable Medical Terms Spell Checker Dictionary in Workspace"
      },
      {
        "command": "cSpellExt_medical-terms.disableWorkspace",
        "title": "Disable Medical Terms Spell Checker Dictionary in Workspace"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "@cspell/dict-medicalterms": "^4.1.9"
  },
  "devDependencies": {
    "@internal/extension-runtime": "file:../../extension-runtime"
  },
  "extensionDependencies": [
    "streetsidesoftware.code-spell-checker"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "images/SpellCheck.png",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "sponsor": {
    "url": "https://github.com/sponsors/streetsidesoftware"
  },
  "vsce": {
    "baseContentUrl": "https://raw.githubusercontent.com/streetsidesoftware/vscode-cspell-dict-extensions/refs/heads/main/extensions/medical-terms/",
    "baseImagesUrl": "https://raw.githubusercontent.com/streetsidesoftware/vscode-cspell-dict-extensions/refs/heads/main/extensions/medical-terms/"
  }
}
