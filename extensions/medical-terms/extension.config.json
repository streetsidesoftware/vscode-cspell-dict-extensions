{
    "$schema": "../../extension-runtime/extension.config.schema.json",
    "name": "medical-terms",
    "kind": "wordList",
    "friendlyName": "Medical Terms",
    "displayName": "Medical Terms - Code Spell Checker",
    "description": "Adds the Medical Terms dictionary to Code Spell Checker.",
    "sample": "samples/README.md",
    "cspell": {
        "import": ["@cspell/dict-medicalterms/cspell-ext.json"]
    },
    "commands": [
        {
            "id": "cSpellExt_medical-terms.enable",
            "title": "Enable Medical Terms Spell Checker Dictionary",
            "action": "enable",
            "toggle": "dictionary",
            "value": "medical terms",
            "scope": "global"
        },
        {
            "id": "cSpellExt_medical-terms.disable",
            "title": "Disable Medical Terms Spell Checker Dictionary",
            "action": "disable",
            "toggle": "dictionary",
            "value": "medical terms",
            "scope": "global"
        },
        {
            "id": "cSpellExt_medical-terms.enableWorkspace",
            "title": "Enable Medical Terms Spell Checker Dictionary in Workspace",
            "action": "enable",
            "toggle": "dictionary",
            "value": "medical terms",
            "scope": "workspace"
        },
        {
            "id": "cSpellExt_medical-terms.disableWorkspace",
            "title": "Disable Medical Terms Spell Checker Dictionary in Workspace",
            "action": "disable",
            "toggle": "dictionary",
            "value": "medical terms",
            "scope": "workspace"
        }
    ]
}
