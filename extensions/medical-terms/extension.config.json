{
    "$schema": "../../static/extension.config.schema.json",
    "name": "medical-terms",
    "kind": "wordList",
    "friendlyName": "Medical Terms",
    "sample": "samples/README.md",
    "cspell": {
        "import": ["@cspell/dict-medicalterms/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "dictionary",
            "value": "medical terms"
        },
        {
            "action": "disable",
            "toggle": "dictionary",
            "value": "medical terms"
        },
        {
            "action": "enable",
            "toggle": "dictionary",
            "value": "medical terms",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "dictionary",
            "value": "medical terms",
            "scope": "workspace"
        }
    ]
}
