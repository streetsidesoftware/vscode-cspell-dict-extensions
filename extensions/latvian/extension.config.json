{
    "$schema": "../../static/extension.config.schema.json",
    "name": "latvian",
    "friendlyName": "Latvian",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-lv/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "lv"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "lv"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "lv",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "lv",
            "scope": "workspace"
        }
    ]
}
