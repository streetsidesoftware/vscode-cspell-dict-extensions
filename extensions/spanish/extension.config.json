{
    "$schema": "../../static/extension.config.schema.json",
    "name": "spanish",
    "kind": "language",
    "friendlyName": "Spanish",
    "nativeName": "español",
    "locale": "es-ES",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-es-es/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "id": "cSpell.enableSpanish"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "id": "cSpell.disableSpanish"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpell.enableSpanishWorkspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpell.disableSpanishWorkspace"
        }
    ],
    "description": "Spanish Add-On for Code Spell Checker"
}
