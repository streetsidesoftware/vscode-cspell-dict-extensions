{
    "$schema": "../../static/extension.config.schema.json",
    "name": "esperanto",
    "kind": "language",
    "friendlyName": "Esperanto",
    "locale": "eo",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-eo/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "id": "cSpellExt_esperanto.enableEsperanto"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "id": "cSpellExt_esperanto.disableEsperanto"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpellExt_esperanto.enableEsperantoWorkspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpellExt_esperanto.disableEsperantoWorkspace"
        }
    ]
}
