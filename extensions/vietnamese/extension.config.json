{
    "$schema": "../../static/extension.config.schema.json",
    "name": "vietnamese",
    "kind": "language",
    "friendlyName": "Vietnamese",
    "nativeName": "Tiếng Việt",
    "locale": "vi",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-vi-vn/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "vi"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "vi"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "vi",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "vi",
            "scope": "workspace"
        }
    ]
}
