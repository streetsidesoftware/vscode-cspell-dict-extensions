{
    "$schema": "../../static/extension.config.schema.json",
    "name": "ancient-greek",
    "friendlyName": "Ancient Greek",
    "sample": "samples/Hymn-4-to-Hermes.md",
    "cspell": {
        "import": ["@cspell/dict-grc/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "grc",
            "title": "Enable Ancient_greek Spell Checker Dictionary"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "grc",
            "title": "Disable Ancient_greek Spell Checker Dictionary"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "grc",
            "scope": "workspace",
            "title": "Enable Ancient_greek Spell Checker Dictionary in Workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "grc",
            "scope": "workspace",
            "title": "Disable Ancient_greek Spell Checker Dictionary in Workspace"
        }
    ]
}
