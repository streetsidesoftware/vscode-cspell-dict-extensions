{
    "$schema": "../../static/extension.config.schema.json",
    "name": "slovenian",
    "kind": "language",
    "friendlyName": "Slovenian",
    "nativeName": "slovenščina",
    "locale": "sl",
    "sample": "samples/Ljubljana.md",
    "cspell": {
        "import": ["@cspell/dict-sl-si/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale"
        },
        {
            "action": "disable",
            "toggle": "locale"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace"
        }
    ]
}
