{
    "$schema": "../../static/extension.config.schema.json",
    "name": "slovenian",
    "friendlyName": "Slovenian",
    "sample": "samples/Ljubljana.md",
    "cspell": {
        "import": ["@cspell/dict-sl-si/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "sl"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "sl"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "sl",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "sl",
            "scope": "workspace"
        }
    ]
}
