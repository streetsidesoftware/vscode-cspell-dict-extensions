{
    "$schema": "../../extension-runtime/extension.config.schema.json",
    "name": "slovenian",
    "kind": "language",
    "friendlyName": "Slovenian",
    "displayName": "Slovenian - Code Spell Checker",
    "description": "Adds Slovenian (slovenščina) spell checking to Code Spell Checker.",
    "nativeName": "slovenščina",
    "locale": "sl-SI",
    "sample": "samples/Ljubljana.md",
    "cspell": {
        "import": ["@cspell/dict-sl-si/cspell-ext.json"]
    },
    "commands": [
        {
            "id": "cSpellExt_slovenian.enable",
            "title": "Enable Slovenian Spell Checker Dictionary",
            "action": "enable",
            "toggle": "locale",
            "value": "sl-SI",
            "scope": "global"
        },
        {
            "id": "cSpellExt_slovenian.disable",
            "title": "Disable Slovenian Spell Checker Dictionary",
            "action": "disable",
            "toggle": "locale",
            "value": "sl,sl-SI",
            "scope": "global"
        },
        {
            "id": "cSpellExt_slovenian.enableWorkspace",
            "title": "Enable Slovenian Spell Checker Dictionary in Workspace",
            "action": "enable",
            "toggle": "locale",
            "value": "sl-SI",
            "scope": "workspace"
        },
        {
            "id": "cSpellExt_slovenian.disableWorkspace",
            "title": "Disable Slovenian Spell Checker Dictionary in Workspace",
            "action": "disable",
            "toggle": "locale",
            "value": "sl,sl-SI",
            "scope": "workspace"
        }
    ]
}
