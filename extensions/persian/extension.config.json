{
    "$schema": "../../static/extension.config.schema.json",
    "name": "persian",
    "kind": "language",
    "friendlyName": "Persian",
    "nativeName": "فارسی",
    "locale": "fa",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-fa-ir/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale"
        },
        {
            "action": "disable",
            "toggle": "locale"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace"
        }
    ]
}
