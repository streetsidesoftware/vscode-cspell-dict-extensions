{
    "$schema": "../../static/extension.config.schema.json",
    "name": "danish",
    "kind": "language",
    "friendlyName": "Danish",
    "nativeName": "dansk",
    "locale": "da",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-da-dk/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "da",
            "id": "cSpellExt_danish.enableDanish"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "da",
            "id": "cSpellExt_danish.disableDanish"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "da",
            "scope": "workspace",
            "id": "cSpellExt_danish.enableDanishWorkspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "da",
            "scope": "workspace",
            "id": "cSpellExt_danish.disableDanishWorkspace"
        }
    ]
}
