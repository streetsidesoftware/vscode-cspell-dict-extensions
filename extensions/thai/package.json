{
  "name": "code-spell-checker-thai",
  "version": "0.0.1",
  "private": true,
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "Thai",
    "VS Code Extension",
    "Spelling Checker",
    "dictionary",
    "spelling"
  ],
  "bugs": {
    "url": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/vscode-cspell-dict-extensions",
    "directory": "extensions/thai"
  },
  "license": "GPL-3.0-or-later",
  "qna": "marketplace",
  "author": "Street Side Software <support@streetsidesoftware.nl>",
  "contributors": [],
  "publisher": "streetsidesoftware",
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "@cspell/dict-th-th": "^1.0.3"
  },
  "extensionDependencies": [
    "streetsidesoftware.code-spell-checker"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "images/SpellCheck.png",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "sponsor": {
    "url": "https://github.com/sponsors/streetsidesoftware"
  },
  "vsce": {
    "baseContentUrl": "https://raw.githubusercontent.com/streetsidesoftware/vscode-cspell-dict-extensions/refs/heads/main/extensions/thai/",
    "baseImagesUrl": "https://raw.githubusercontent.com/streetsidesoftware/vscode-cspell-dict-extensions/refs/heads/main/extensions/thai/"
  },
  "displayName": "Thai - Code Spell Checker",
  "description": "Adds Thai (ไทย) spell checking to Code Spell Checker.",
  "type": "module",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cSpellExt_thai.enable",
        "title": "Enable Thai Spell Checker Dictionary"
      },
      {
        "command": "cSpellExt_thai.disable",
        "title": "Disable Thai Spell Checker Dictionary"
      },
      {
        "command": "cSpellExt_thai.enableWorkspace",
        "title": "Enable Thai Spell Checker Dictionary in Workspace"
      },
      {
        "command": "cSpellExt_thai.disableWorkspace",
        "title": "Disable Thai Spell Checker Dictionary in Workspace"
      }
    ]
  },
  "devDependencies": {
    "@internal/extension-runtime": "file:../../extension-runtime"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node ../../scripts/clean.mts",
    "clean-build": "npm run clean && npm run build",
    "pack-extension": "vsce package",
    "publish-extension": "vsce publish",
    "test": "npm run test:cspell && npm run test:vscode",
    "test:cspell": "cspell -c static/cspell-ext.json samples",
    "test:vscode": "node ../../test-runner/bin.mjs . --sample samples/seattle.md",
    "vscode:prepublish": "npm run build",
    "watch": "tsdown --watch"
  }
}
