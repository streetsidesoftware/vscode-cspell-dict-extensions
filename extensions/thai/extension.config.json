{
    "$schema": "../../static/extension.config.schema.json",
    "name": "thai",
    "kind": "language",
    "friendlyName": "Thai",
    "nativeName": "ไทย",
    "locale": "th-TH",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-th-th/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "th-TH"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "th,th-TH"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "th-TH",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "th,th-TH",
            "scope": "workspace"
        }
    ]
}
