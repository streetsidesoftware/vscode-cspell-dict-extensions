{
    "$schema": "../../static/extension.config.schema.json",
    "name": "portuguese-brazilian",
    "kind": "language",
    "friendlyName": "Brazilian Portuguese",
    "nativeName": "português (Brasil)",
    "locale": "pt-BR",
    "sample": "samples/Seattle.md",
    "cspell": {
        "import": ["@cspell/dict-pt-br/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "pt,pt_BR",
            "title": "Enable Portuguese Brazilian Spell Checker Dictionary"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "pt,pt_BR",
            "title": "Disable Portuguese Brazilian Spell Checker Dictionary"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "pt,pt_BR",
            "scope": "workspace",
            "title": "Enable Portuguese Brazilian Spell Checker Dictionary in Workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "pt,pt_BR",
            "scope": "workspace",
            "title": "Disable Portuguese Brazilian Spell Checker Dictionary in Workspace"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "pt,pt_BR",
            "id": "cSpellExt_portuguese-brazilian.enablePortuguese_brazilian",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "pt,pt_BR",
            "id": "cSpellExt_portuguese-brazilian.disablePortuguese_brazilian",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "pt,pt_BR",
            "scope": "workspace",
            "id": "cSpellExt_portuguese-brazilian.enablePortuguese_brazilianWorkspace",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "pt,pt_BR",
            "scope": "workspace",
            "id": "cSpellExt_portuguese-brazilian.disablePortuguese_brazilianWorkspace",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        }
    ]
}
