{
    "$schema": "../../static/extension.config.schema.json",
    "name": "czech",
    "kind": "language",
    "friendlyName": "Czech",
    "nativeName": "čeština",
    "locale": "cs",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-cs-cz/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "id": "cSpellExt_czech.enableCzech"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "id": "cSpellExt_czech.disableCzech"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpellExt_czech.enableCzechWorkspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "scope": "workspace",
            "id": "cSpellExt_czech.disableCzechWorkspace"
        }
    ]
}
