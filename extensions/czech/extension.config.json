{
    "$schema": "../../static/extension.config.schema.json",
    "name": "czech",
    "kind": "language",
    "friendlyName": "Czech",
    "nativeName": "čeština",
    "locale": "cs",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-cs-cz/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "cs"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "cs"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "cs",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "cs",
            "scope": "workspace"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "cs",
            "id": "cSpellExt_czech.enableCzech",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "cs",
            "id": "cSpellExt_czech.disableCzech",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "cs",
            "scope": "workspace",
            "id": "cSpellExt_czech.enableCzechWorkspace",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "cs",
            "scope": "workspace",
            "id": "cSpellExt_czech.disableCzechWorkspace",
            "contributes": false,
            "legacy": true,
            "notes": "Original command ID, kept registered so existing keybindings and tasks keep working."
        }
    ]
}
