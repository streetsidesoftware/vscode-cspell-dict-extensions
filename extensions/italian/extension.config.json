{
    "$schema": "../../static/extension.config.schema.json",
    "name": "italian",
    "kind": "language",
    "friendlyName": "Italian",
    "nativeName": "italiano",
    "locale": "it",
    "sample": "samples/seattle.md",
    "cspell": {
        "import": ["@cspell/dict-it-it/cspell-ext.json"]
    },
    "commands": [
        {
            "action": "enable",
            "toggle": "locale",
            "value": "it"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "it"
        },
        {
            "action": "enable",
            "toggle": "locale",
            "value": "it",
            "scope": "workspace"
        },
        {
            "action": "disable",
            "toggle": "locale",
            "value": "it",
            "scope": "workspace"
        }
    ]
}
