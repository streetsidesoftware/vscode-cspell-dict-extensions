{
    "version": "0.2",
    "dictionaryDefinitions": [
        {
            "name": "project-words",
            "path": "./custom-words.txt",
            "description": "Workspace level words",
            "addWords": true
        }
    ],
    "useGitignore": true,
    "ignorePaths": [
        "extensions/*/extension.js",
        ".git",
        ".gitattributes",
        ".gitignore",
        ".travis.yml",
        ".vscode",
        ".vscodeignore",
        ".vscode-test/**",
        "*.vsix",
        "**/templates/samples/**",
        "CHANGELOG.md",
        "extensions/*/samples/**",
        "node_modules",
        "package-lock.json",
        "extension-tools/templates/create/**",
        "static/generated"
    ],
    "dictionaries": [
        "project-words"
    ],
    "patterns": [
        {
            "name": "native-name",
            "description": "A language's name in the language itself, in extension.config.json.",
            "pattern": "/\"nativeName\":\\s*\"[^\"]*\"/g"
        },
        {
            "name": "language-description",
            "description": "A language extension's description, which repeats its nativeName: in package.json and the extension list in README.md.",
            "pattern": "/Adds\\s[^\"]*?\\sspell\\s+checking\\s+to\\s+Code\\s+Spell\\s+Checker\\./g"
        }
    ],
    "ignoreRegExpList": ["native-name", "language-description"]
}
