{
    "version": "0.2",
    "dictionaryDefinitions": [
        {
            "name": "project-words",
            "path": "./custom-words.txt",
            "description": "Workspace level words",
            "addWords": true
        }
    ],
    "useGitignore": true,
    "ignorePaths": [
        ".git",
        ".gitattributes",
        ".gitignore",
        ".travis.yml",
        ".vscode",
        ".vscodeignore",
        ".vscode-test/**",
        "*.vsix",
        "**/templates/samples/**",
        "CHANGELOG.md",
        "extensions/*/samples/**",
        "node_modules",
        "package-lock.json",
        "generator-cspell-dicts-extensions/templates/**",
        "static/generated"
    ],
    "dictionaries": [
        "project-words"
    ],
    "patterns": [
        {
            "name": "native-name",
            "description": "A language's name in the language itself, in extension.config.json.",
            "pattern": "/\"nativeName\":\\s*\"[^\"]*\"/g"
        }
    ],
    "ignoreRegExpList": ["native-name"]
}
